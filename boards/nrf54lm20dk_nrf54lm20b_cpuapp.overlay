#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <samples/matter/nrf54lm20_cpuapp_partitions.dtsi>

/ {
    chosen {
        nordic,pm-ext-flash = &mx25r64;
    };

    aliases {
        pir = &pir_sensor;
        bh1750 = &bh1750;
        led-strip = &ws2812b_ring;
        fan-pwm = &fan_pwm;
        dmic-dev = &pdm20;
    };

    pwmleds {
        compatible = "pwm-leds";

        fan_pwm: fan_pwm {
            pwms = <&pwm20 2 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
        };
    };

    gpio_keys {
        compatible = "gpio-keys";

        pir_sensor: pir_sensor {
            gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
            label = "HC-SR501 PIR";
        };
    };

    ws2812b_ring: ws2812b-ring {
        compatible = "worldsemi,ws2812-gpio";
        gpios = <&gpio3 0 GPIO_ACTIVE_HIGH>;
        chain-length = <12>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
        reset-delay = <50>;
    };
};

&mx25r64 {
    status = "okay";
};

&i2c21 {
    status = "okay";
    pinctrl-0 = <&i2c21_default>;
    pinctrl-1 = <&i2c21_sleep>;
    pinctrl-names = "default", "sleep";

    bh1750: light-sensor@23 {
        compatible = "rohm,bh1750";
        reg = <0x23>;
        status = "okay";
    };
};

&pwm20 {
    status = "okay";
    pinctrl-0 = <&pwm20_default>;
    pinctrl-1 = <&pwm20_sleep>;
    pinctrl-names = "default", "sleep";
};

dmic_dev: &pdm20 {
    status = "okay";
    pinctrl-0 = <&pdm20_default>;
    pinctrl-names = "default";
};

&pinctrl {
    i2c21_default: i2c21_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 12)>,
                    <NRF_PSEL(TWIM_SCL, 1, 13)>;
        };
    };

    i2c21_sleep: i2c21_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 12)>,
                    <NRF_PSEL(TWIM_SCL, 1, 13)>;
            low-power-enable;
        };
    };

    pwm20_default: pwm20_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT2, 3, 2)>;
        };
    };

    pwm20_sleep: pwm20_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT2, 3, 2)>;
            low-power-enable;
        };
    };

    pdm20_default: pdm20_default {
        group1 {
            psels = <NRF_PSEL(PDM_CLK, 1, 14)>,
                    <NRF_PSEL(PDM_DIN, 1, 11)>;
        };
    };
};
